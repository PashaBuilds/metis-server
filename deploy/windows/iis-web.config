<?xml version="1.0" encoding="UTF-8"?>
<!--
  METIS için IIS ters vekil örneği (KURULUM.md, 5. adım). Gerekenler: IIS URL Rewrite 2.1 + Application Request Routing 3.0
  (çevrimdışı .msi kurucuları). Bu dosya IIS sitesinin kök klasörüne (ör. C:\inetpub\metis\web.config) konur.
  - TLS IIS'te sonlanır (şirket sertifikası, 443). METIS yalnız 127.0.0.1:8000 dinler.
  - Mentor ve görev akışları Server-Sent Events kullanır: yanıt tamponlama ve sıkıştırma bu yollar için kapatılır.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="HTTP'den HTTPS'e" stopProcessing="true">
          <match url="(.*)" />
          <conditions><add input="{HTTPS}" pattern="off" /></conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="METIS" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- SSE (text/event-stream) sıkıştırılmaz; ARR tamponu kapalı (ApplicationHost: responseBufferLimit=0, aşağıdaki not). -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />
    <security>
      <requestFiltering>
        <!-- Kaynak yükleme sınırı 10 MB (METIS_MAX_UPLOAD_BYTES ile aynı); çok parçalı ek yük için pay bırakıldı. -->
        <requestLimits maxAllowedContentLength="12582912" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
<!--
  Sunucu düzeyinde bir kez (yönetici PowerShell):
    & "$env:windir\system32\inetsrv\appcmd.exe" set config -section:system.webServer/proxy /enabled:"True" /preserveHostHeader:"True" /timeout:"00:10:00" /commit:apphost
    & "$env:windir\system32\inetsrv\appcmd.exe" set config -section:system.webServer/proxy /responseBufferLimit:"0" /commit:apphost
    & "$env:windir\system32\inetsrv\appcmd.exe" set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_X_FORWARDED_PROTO']" /commit:apphost
-->
