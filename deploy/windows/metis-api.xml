<!-- WinSW servis tanımı: METIS API + web arayüzü. install-offline.ps1 {{…}} alanlarını doldurur. -->
<service>
  <id>metis-api</id>
  <name>METIS API</name>
  <description>METIS v2 web/API sunucusu. Yalnız 127.0.0.1 üzerinde dinler; dış erişim IIS/ARR ters vekiliyle (TLS).</description>
  <executable>{{ROOT}}\app\current\python\python.exe</executable>
  <arguments>-m metis.cli serve --host 127.0.0.1 --port {{PORT}} --workers {{WORKERS}}</arguments>
  <env name="METIS_CONFIG" value="{{ENV}}"/>
  <env name="PYTHONUTF8" value="1"/>
  <workingdirectory>{{ROOT}}\data</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>20 sec</stoptimeout>
  <logpath>{{ROOT}}\data\logs\service</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
