[Unit]
Description=METIS Worker (iş kuyruğu, bakım zamanlayıcısı)
After=network-online.target postgresql.service

[Service]
User={{USER}}
Environment=METIS_CONFIG={{ROOT}}/config/metis.env
Environment=PYTHONUTF8=1
WorkingDirectory={{ROOT}}/data
ExecStart={{ROOT}}/app/current/venv/bin/python -m metis.cli worker --slots {{SLOTS}}
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
